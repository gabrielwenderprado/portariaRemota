<Window x:Class="LoginExemplo.RemoverUsuario"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remover Usuário"
        Height="400"
        Width="300"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Border Background="White"
                Padding="20"
                Margin="20"
                CornerRadius="10">

            <StackPanel>

                <TextBlock Text="Usuários Cadastrados"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,15"
                           HorizontalAlignment="Center"/>

                <ListBox x:Name="lstUsuarios"
                         Height="180"
                         Margin="0,0,0,10"/>

                <Button x:Name="btnRemover"
                        Content="Remover Usuário"
                        Height="20"
                        Background="#D32F2F"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnRemover_Click"/>

                <Button x:Name="btnVoltar"
                        Content="Voltar"
                        Height="20"
                        Margin="0,10,0,0"
                        Background="#6200EE"
                        Foreground="White"
                        BorderThickness="0"
                        Click="btnVoltar_Click"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>