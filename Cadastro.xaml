    <!-- Atributos da janeta -->
    
    <Window x:Class="LoginExemplo.Cadastro" 
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid> <!-- Define a borda para estilizar a tela -->
        <Border Background="White"
                Padding="30"
                CornerRadius="10"
                Width="300"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <StackPanel>

                <!-- Título -->
                <TextBlock Text="CADASTRO"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <!-- Usuário -->
                <TextBlock Text="Usuário" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUserCad"
                         Height="30"
                         Margin="0,0,0,10"/>

                <!-- Senha -->
                <TextBlock Text="Senha" Margin="0,0,0,5"/>
                <PasswordBox x:Name="pswSenhaCad"
                             Height="30"
                             Margin="0,0,0,20"/>

                <!-- Botões -->
                <Button x:Name="btnCadastrar"
                        Content="Cadastrar usuário"
                        Height="20"
                        Background="#6200EE"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="20,0,20,15"
                        Click="btnCadastrar_Click"/>

                <Button x:Name="btnVoltar"
                        Content="Voltar"
                        Height="20"
                        Background="#FF0000"
                        Foreground="White"
                        BorderThickness="0"
                        Margin="20,0,20,15"
                        Click="btnVoltar_Click"/>

                <!-- Aviso -->
                <TextBlock Text="Não esqueça sua senha!"
                           FontSize="12"
                           Foreground="Gray"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>
    </Grid>
</Window>
